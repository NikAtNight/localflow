<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Notarization requires the hardened runtime, which denies the
	     microphone unless it is requested explicitly. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- WhisperKit downloads CoreML models from Hugging Face on first run,
	     and the optional Ollama backend talks to localhost. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- CoreML compiles the Whisper models to executable form on first load;
	     the hardened runtime blocks that JIT step without this. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
